{
  "name": "dsh-dafeiyu-sleep",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 设置页面板：查看和修改 AstrBot 大肥鱼睡觉插件的疲惫值、睡眠状态与作息参数。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "astrbot",
    "sleep",
    "ui"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyxiancong/dsh-dafeiyu-sleep.git"
  },
  "homepage": "https://github.com/happyxiancong/dsh-dafeiyu-sleep#readme",
  "bugs": {
    "url": "https://github.com/happyxiancong/dsh-dafeiyu-sleep/issues"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
